[Unit]
Description=SmartRoad AP (Flask + React) — bare python web_app.py
Documentation=file://__ROOT__/docs/ops/server.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
# Same as: cd repo && source venv && python -u web_app.py
# Do NOT wrap in supervise/watchdog — that was killing the portal mid-request.
ExecStart=__ROOT__/venv/bin/python -u __ROOT__/web_app.py
Restart=always
RestartSec=3
StartLimitIntervalSec=0
KillMode=mixed
TimeoutStopSec=60
LimitNOFILE=65535
User=__USER__
Group=__GROUP__
Environment=PYTHONUNBUFFERED=1
# Flask loads .env itself; these two pins avoid NAT hairpin if .env is wrong.
Environment=DB_HOST=127.0.0.1
Environment=DB_FORCE_LOCALHOST=1
Environment=SMARTROAD_SERVER=werkzeug
Environment=FLASK_DEBUG=false
# Idle logout — 30 min (set SESSION_IDLE_TIMEOUT_S in .env to override)
Environment=SESSION_IDLE_TIMEOUT_S=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartroad

[Install]
WantedBy=multi-user.target
