# SmartRoad — environment template (copy to `.env` and fill secrets)
#
#   cp .env.example .env          # Linux/macOS
#   copy .env.example .env        # Windows
#
# Production host notes: docs/ops/server.md
# Never commit `.env` — it holds DB passwords, AWS keys, FLASK_SECRET_KEY.

# ── Flask / auth (required in production) ─────────────────────────────────────
FLASK_PORT=5005
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# ── Postgres (required for login, dashboard, persistence) ─────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smartroad_ap
DB_USER=postgres
DB_PASSWORD=
# On the app server VM use loopback, not the public IP (hairpin NAT hangs login):
# DB_FORCE_LOCALHOST=1

# ── AWS / S3 (optional — leave empty for local file uploads only) ─────────────
# Without these, Detection still works with browser/local uploads; no S3 dropdown.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=              # only if using temporary STS credentials
AWS_REGION=ap-south-1
# AWS_USE_INSTANCE_PROFILE=1      # EC2/IMDS instead of access keys

S3_INPUT_BUCKET=smart-road-videos
S3_PROCESSED_BUCKET=smart-road-videos-processed
S3_REPORTS_BUCKET=smartroad-reports
# Optional key prefix inside input bucket (e.g. videographer/):
# S3_INPUT_PREFIX=
# S3_PRESIGN_EXPIRY=604800
# S3_PUBLIC=false
# S3_MOVE_ON_SUCCESS=true

# ── Roboflow (optional — only for tools/ml/download_data.py training data) ────
# ROBOFLOW_API_KEY=rf_xxxxxxxxxxxxxxxx

# ── Model weights (optional until you deploy/train a .pt) ─────────────────────
# MODEL_PATH=artifacts/models/smartroad_ap.pt

# Production flag — also enables auto-detect defaults (see below).
SMARTROAD_ENV=production
AUTO_DETECT_ON_UPLOAD=1
AUTO_DETECT_SCAN_S3=1

# Local dev: leave SMARTROAD_ENV unset (or set AUTO_DETECT_ON_UPLOAD=0) so the
# worker does not scan S3 / queue YOLO unless you opt in.
# Bump SESSION_EPOCH + restart to invalidate logins under the current cookie names.
SESSION_EPOCH=20260715b
SESSION_IDLE_TIMEOUT_S=3600
SESSION_IDLE_TIMEOUT_MOBILE_S=604800
JWT_TTL_S=604800
# JWT_SECRET=   # optional; defaults to FLASK_SECRET_KEY
# Cookie names (defaults sr_session / sr_remember). Changing them again nukes all clients.
# SESSION_COOKIE_NAME=sr_session
# REMEMBER_COOKIE_NAME=sr_remember

# ── Postgres pool / timeouts (tune on shared hosts) ───────────────────────────
# On AceCloud (Postgres on same VM): ALWAYS use loopback — never the public IP.
# DB_HOST=45.194.2.247 from the box itself hairpins NAT and login hangs forever.
DB_FORCE_LOCALHOST=1
# Pool auto-sizes to WAITRESS_THREADS + DB_POOL_HEADROOM when DB_POOL_MAX unset.
# Raise Postgres first, then size app pools so portal+upload+detect fit under it:
#   ALTER SYSTEM SET max_connections = 2000;  -- restart Postgres after
# WAITRESS_THREADS=128
# DB_POOL_HEADROOM=64
# DB_POOL_HARD_CAP=512
# DB_POOL_MIN=64
# DB_POOL_MAX=256
DB_POOL_MIN=64
DB_POOL_MAX=256
DB_POOL_HARD_CAP=512
DB_POOL_GET_TIMEOUT_S=45
DB_POOL_GET_RETRIES=10
DB_CONNECT_TIMEOUT=5
DB_PING_TIMEOUT_S=2
SURVEY_JSON_MIRROR=0
TRACKING_JSON_MIRROR=0
# SURVEY_STATE_CACHE_S=3
# Geocode: Photon (fast OSM) then Nominatim fallback. Set GEOCODE_PROVIDER=nominatim to skip Photon.
# GEOCODE_PROVIDER=photon
# GEOCODE_CACHE_S=1800
# NOMINATIM_CACHE_S=3600
# PHOTON_URL=https://photon.komoot.io/api/
# REPORT_GPS_CELL_M=40
# Do NOT set each process pool to 2000 — 3×2000 would need max_connections > 6000.
# Example budget with max_connections=2000: portal 256 + upload 128 + detect 64 ≈ 450.

# ── YOLO / detection (GPU for infer, CPU for decode/draw) ─────────────────────
# Split deploy: portal/upload force YOLO_DEVICE=cpu in scripts/services.sh;
# only the detect process (port 5007) uses GPU for /api/detection + /api/model-bench.
DETECT_YOLO_DEVICE=0
DETECT_CUDA_VISIBLE_DEVICES=0
YOLO_DEVICE=0
POTHOLE_HALF=1
# Dust / loose-dirt FP filter (classical CV, no extra model).
# Toggle: POTHOLE_DUST_GUARD=1 on | =0 off (restart detect after change).
# POTHOLE_DUST_GUARD=0
# POTHOLE_DUST_SCORE=0.68
# POTHOLE_DUST_MIN_BOX=5          # score boxes >= NxN (was 8; highway distant)
# POTHOLE_DUST_DARK_FRAC=0.05     # dark_frac bypass / wet-patch override
# Leave few cores for portal/login while YOLO runs (frame draw still on CPU):
POTHOLE_CPU_THREADS=3
# Training DataLoader workers stay on CPU (disk/JPEG/augment) — use 0, not 8.
YOLO_WORKERS=0
# H.264: NVDEC decode + NVENC encode when FFMPEG_HW=auto and system ffmpeg has CUDA
FFMPEG_HW=auto
FFMPEG_PREFER_SYSTEM=1
# Do NOT enable multi-process parallel on GPU (CUDA + fork breaks / VRAM fight).
# POTHOLE_PARALLEL=false   # already forced off when YOLO_DEVICE != cpu
# Train: python tools/ml/train_yolo.py --device 0 --workers 0
# After .env change: ./scripts/services.sh restart detect

# ── ffmpeg (prefer system binary with NVENC on AceCloud) ──────────────────────
FFMPEG_NVENC_PRESET=p4
FINALIZE_CONCURRENCY=1
FINALIZE_FFMPEG_THREADS=2

# ── S3 (server → AWS after phone upload; I/O, uses CPU threads) ───────────────
S3_UPLOAD_CONCURRENCY=48
S3_MULTIPART_CHUNK_MB=16

# ── Mobile-data upload guard (phone → Flask) ──────────────────────────────────
CHUNK_UPLOAD_CONCURRENCY=8
CHUNK_UPLOAD_IDLE_TIMEOUT_S=90
CHUNK_UPLOAD_ABSOLUTE_TIMEOUT_S=600
SMARTROAD_HEAVY_CONCURRENCY=24

# ── Citizen reporter portal (mobile OTP + complaint uploads) ──────────────────
# Separate from staff users. Migrations:
#   migrations/20260720_reporter_portal.sql
#   migrations/20260720_reporter_otp_restore.sql
#   migrations/20260721_reporter_otp_plain.sql   # plain_otp column on challenges (dev only)
# REPORTER_JWT_SECRET=            # optional; defaults to FLASK_SECRET_KEY
REPORTER_JWT_TTL_S=2592000      # 30 days
S3_REPORTER_BUCKET=smart-road-videos   # users/{reporter_id}/ keys
# Testing OTP (hash + plain_otp in reporter_otp_challenges; JSON mirror on disk)
REPORTER_OTP_PROVIDER=log
REPORTER_OTP_RETURN=1
REPORTER_OTP_LENGTH=6
REPORTER_OTP_TTL_S=86400
# REPORTER_OTP_MAX_ATTEMPTS=5
# REPORTER_OTP_JSON=data/reporter_otps.json
# Before production SMS: DROP COLUMN plain_otp; clear JSON + old challenges
